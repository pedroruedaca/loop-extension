{
  "manifest_version": 3,
  "name": "Loop for Mercadona",
  "version": "0.1.0",
  "description": "Links Loop's recurring grocery list to your real Mercadona account, acting entirely in your own browser session.",
  "key": "",
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "tabs"],
  "host_permissions": [
    "https://tienda.mercadona.es/*",
    "http://localhost:3000/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://tienda.mercadona.es/*"],
      "js": ["content/mercadona-content.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://tienda.mercadona.es/*"],
      "js": ["content/page-hook.js"],
      "world": "MAIN",
      "run_at": "document_start"
    }
  ],
  "externally_connectable": {
    "matches": ["http://localhost:3000/*"]
  },
  "action": {
    "default_popup": "popup/popup.html"
  }
}
